<script>
  const images = [
    "/images/portfolio/tieatie/mockup.png",
    "/images/portfolio/mosa/1Tickets.png",
    "/images/portfolio/wenbox/7.png",
    "/images/portfolio/stewartsmith/13.png",
    "/images/portfolio/kaka/01.png",
    "/images/portfolio/convergence/Posters.png",
    "/images/portfolio/fishingbrochure/fishingBrochure5.png",
  ];

  const backgrounds = document.querySelectorAll(".bg-image");

  // Preload images
  images.forEach((src) => {
    const img = new Image();
    img.src = src;
  });

  let currentImage = 0;
  let activeBackground = 0;

  // Set the first image
  backgrounds[0].style.backgroundImage = `url(${images[0]})`;

  setInterval(() => {
    // Move to next image
    currentImage = (currentImage + 1) % images.length;

    // Choose the background layer that's currently hidden
    const nextBackground = backgrounds[1 - activeBackground];

    // Set its image
    nextBackground.style.backgroundImage = `url(${images[currentImage]})`;

    // Fade it in
    nextBackground.style.opacity = "1";

    // Fade the old one out
    backgrounds[activeBackground].style.opacity = "0";

    // Swap active layer
    activeBackground = 1 - activeBackground;

  }, 5000);
</script>