---
layout: layouts/default.njk
header: Portfolio
---
<div class="gallery">
    {% for portfolio in collections.portfolio | sort(attribute="data.year") | reverse %}
        <div class="gallery-item">
            <a href="{{ portfolio.url }}"> 
                <img class="galleryimg" style="object-position: {{ portfolio.data.cardPosition or "center" }};"src="{{ portfolio.data.cardImage }}">
                <p class="desc"> {{ portfolio.data.header }} </p>
            </a>
            <div class="tags">
                    {% for tag in portfolio.data.tags %}
                        {% if tag != "portfolio" %}
                        <span>{{ tag }}</span>
                        {% endif %}
                    {% endfor %}
                </div>
        </div>
    {% endfor %}  
</div>

{% include "partials/breadcrumbs.njk" ignore missing %}