---
layout: layouts/default.njk
---
<div class="contentblock">
    <h2> {{ year }}</h2>
    <div class="contentblock" style="text-align: center;">
        {% for page in collections["film-diary"] | reverse %}
            / <a href="{{page.url}}">{{page.data.year}}</a>
        {%endfor%}
    </div>
    <div class="filters">
        <h3> Type </h3>
        <button data-type="Movie">Movies</button>
        <button data-type="Series">Series</button>
        {# <h3> Tags </h3> 
        {% for tag in mediaTags %}
            <button data-tag="{{ tag }}">{{ tag }}</button>
        {% endfor %}#}
    </div>
<br>
            {% set sorted = media | sort(false, false, "date") | reverse %}

            {% for item in sorted %}
                {% if item.date and item.date.startsWith(year) %}
                        <div class="item" data-type="{{ item.type }}" data-tags="{{ item.tags }}" data-status="{{ item.status }}">
                                    <span class="date">{{ item.date }}</span>
                                    <div class="item-info">
                                        <span class="title">{{item.title}}</span>
                                        <span class="rating">{{"★".repeat(item.rating.length)}}</span>
                                    </div>
                                    <div class="comment"> 
                                        <p>{{item.comment}} </p>
                                    </div>
                                </div>
                    {% endif %}
            {% endfor %}
    </div>
</div>
<script>
const items = document.querySelectorAll(".item");
const buttons = document.querySelectorAll("button");

let activeStatus = null;
let activeFilters = {
    type: null,
    tag: null,
};

buttons.forEach(btn => {
    btn.addEventListener("click", () => {

        // TYPE
        if (btn.dataset.type) {
            activeFilters.type =
                activeFilters.type === btn.dataset.type
                    ? null
                    : btn.dataset.type;

            toggleActive(btn, "data-type");
        }

        // TAG
        if (btn.dataset.tag) {
            activeFilters.tag =
                activeFilters.tag === btn.dataset.tag
                    ? null
                    : btn.dataset.tag;

            toggleActive(btn, "data-tag");
        }


        applyFilters(); // IMPORTANT: always runs once per click
    });
});

function toggleActive(clickedBtn, attr) {
    const group = document.querySelectorAll(`button[${attr}]`);

    const isActive = clickedBtn.classList.contains("active");

    group.forEach(b => b.classList.remove("active"));

    if (!isActive) {
        clickedBtn.classList.add("active");
    }
}

function applyFilters() {
    items.forEach(item => {

        const typeMatch =
            !activeFilters.type ||
            item.dataset.type === activeFilters.type;

        const tagMatch =
            !activeFilters.tag ||
            item.dataset.tags.split(",").includes(activeFilters.tag);

        const statusMatch =
            !activeFilters.status ||
            item.dataset.status === activeFilters.status;

        item.style.display =
            (typeMatch && tagMatch && statusMatch)
                ? ""
                : "none";
    });
}
</script>