<!DOCTYPE html>

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title> {{ header }} </title>
        <link rel="stylesheet" href="/css/style.css">
    </head>
    <body>
    <div class="container">
        <main>
        {% if page.url == "/" %}
        <div class="banner">
             <h1>{{ header }}</h1>
        </div>
        {% else %}
            {% include "partials/header.njk" ignore missing %}
            {% if imgHero %}
                <figure>
                    <img class="img" src="/images/{{ imgHero }}" alt tooltip="{{ imgCaption }}">
                    <figcaption> {{ imgCaption }} </figcaption>
                </figure>
            {% endif%}
            {% if "shrines" in page.url %}

            {% else %}
                <h1 class="head">{{ header }}</h1>
            {% endif%}
        {% endif %}

                {{ content | safe }}
            
        </main>
    </div>
    </body>
</html>
