<!DOCTYPE html>

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <title> {{ header }} </title>
        <link rel="stylesheet" href="/css/style.css">
    </head>
    <body {% if "garden" in page.url %} class="garden" {%endif%}>
    
    <div class="container">
        <main>
        {% if page.url == "/garden/" %}
        <div class="banner">
             <h1>{{ header }}</h1>
        </div>
        {% else %}
            {% if "garden" in page.url %}
                {% include "partials/header.njk" ignore missing %}
            {%else%}
                {% include "partials/portfolio-header.njk" ignore missing %}
            {%endif%}
            {% if empty %} {# if the page wants a widscreen layout#}
                </div>
                <div class="full-container">
            {%endif%}
            {% if imgHero %}
                <figure>
                    <img class="img" src="/images/{{ imgHero }}" alt tooltip="{{ imgCaption }}">
                    <figcaption> {{ imgCaption }} </figcaption>
                </figure>
            {% endif%}
            {% if "shrines" not in page.url %}
                {% if not empty %}
                    <h1 class="head">{{ header }}</h1>
                {% endif%}
            {%endif%}
        {% endif %}

                {{ content | safe }}
            
        </main>

    </div>

    </body>
</html>
